{
  "name": "survey-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Khảo sát công khai, quản trị riêng tư; database Neon Postgres tạo trong Vercel Storage và SQLite cho local.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "build": "node scripts/build.mjs",
    "vercel-build": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "reset-password": "node reset-password.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8"
  }
}
