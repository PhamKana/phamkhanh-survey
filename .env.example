# Vercel Storage > Neon Postgres > Connect Project automatically adds DATABASE_URL.
# POSTGRES_URL is also supported for an integration using that prefix.
DATABASE_URL=
ADMIN_USERNAME=admin
# Choose your own password (12-256 characters). Only used if database has no admin.
ADMIN_INITIAL_PASSWORD=
# Optional for a custom domain. Vercel *.vercel.app URLs are detected automatically.
APP_ORIGIN=
