# Fill these in Vercel > Settings > Environment Variables (Production).
# Create a libSQL database in Turso; do not use Turso Database-only SDK endpoints.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=
ADMIN_USERNAME=admin
# Choose your own password (12-256 characters). Only used if database has no admin.
ADMIN_INITIAL_PASSWORD=
# Optional for a custom domain. Vercel *.vercel.app URLs are detected automatically.
APP_ORIGIN=
